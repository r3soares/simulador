{
  "name": "simulador-php",
  "version": "0.2.0",
  "private": true,
  "description": "Simulador didático de uma pilha web PHP (balanceador, Apache, PHP-FPM, Redis, MySQL)",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "check": "node scripts/build.mjs --check",
    "test": "node --test \"test/engine/**/*.test.js\"",
    "test:e2e": "npm run build && playwright test",
    "check:links": "node scripts/check-links.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.49.1",
    "esbuild": "0.24.2"
  }
}
